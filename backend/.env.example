# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_PREFIX=/api/v1

# ==========================================
# MONGODB
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRES=7d

# ==========================================
# EMAIL VERIFICATION / RESET TOKENS
# ==========================================
EMAIL_TOKEN_SECRET=replace_with_email_token_secret
EMAIL_TOKEN_EXPIRES=1d

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# CLOUDINARY
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# SMTP (NODEMAILER)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="CloudVision AI <no-reply@cloudvision.ai>"

# ==========================================
# FASTAPI AI SERVICE
# ==========================================
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=120000
AI_SERVICE_API_KEY=replace_with_shared_secret_between_express_and_fastapi

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100